# =========================================================
# Root .htaccess - Forward all requests to /public folder
# Untuk deployment cPanel di mana repo ada di public_html/
# =========================================================

RewriteEngine On

# Elak akses ke fail .config.php dan fail tersembunyi
RewriteRule ^\.config\.php$ - [F,L]
RewriteRule ^\.  - [F,L]

# Elak akses langsung ke folder sensitif
RewriteRule ^(controllers|models|utils|views|logs|docs)(/|$) - [F,L]

# Jika request bukan ke /public, forward ke /public
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]

# Elak directory listing
Options -Indexes
